{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "update": "notify",
  "snapshots": true,
  "skills": ["./skills"],
  "instructions": [
    "AGENTS.md",
    ".opencode/agents/*",
    "./opencode/rules/*",
    "https://raw.githubusercontent.com/JRedeker/opencode-shell-strategy/trunk/shell_strategy.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "ask" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git *", "effect": "ask" },
    { "action": "tool.use", "resource": "shell:gh *", "effect": "ask" }
  ],
  "default_agent": "plan",
  "agents": {
    "plan": { "mode": "primary" },
    "build" { "mode": "primary" },
    "writer": { "mode": "subagent" },
    "reviewer": { "mode": "subagent" },
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": "15%",
  },
}
