* text=auto

# Source
*.cs      text diff=csharp
*.js      text
*.json    text
*.html    text
*.css     text
*.md      text diff=markdown
*.yml     text
*.yaml    text
*.xml     text

# Windows scripts
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binaries/assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.exe     binary
*.dll     binary
*.pdb     binary
*.zip     binary
*.7z      binary

# Preserve generated/runtime artifacts formatting when present
*.lnk     binary
*.url     text eol=crlf
